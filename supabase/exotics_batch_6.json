  "information": [
    {
      "drug_name": "Cisapride",
      "section": "Exotics overview",
      "content": "GI prokinetic related to metoclopramide, used mainly for rabbit and guinea pig GI stasis/hypomotility. It has no central antiemetic effect."
    },
    {
      "drug_name": "Cisapride",
      "section": "Key caution",
      "content": "Efficacy may be variable and obstruction must be excluded. Use carefully with drugs that alter CYP3A4 or gut motility."
    },
    {
      "drug_name": "Ranitidine",
      "section": "Exotics overview",
      "content": "H2 receptor antagonist with acid-suppressing and prokinetic use in selected exotic mammals. Availability of human preparations may be limited."
    },
    {
      "drug_name": "Ranitidine",
      "section": "Key caution",
      "content": "Rapid IV administration can cause hypotension/arrhythmias. Stagger from sucralfate, antacids, digoxin and metoclopramide where possible."
    },
    {
      "drug_name": "Famotidine",
      "section": "Exotics overview",
      "content": "H2 receptor antagonist used for acid suppression and ulcer support in selected exotic mammals. It has fewer classic H2-blocker interactions than cimetidine."
    },
    {
      "drug_name": "Famotidine",
      "section": "Key caution",
      "content": "Review ongoing need for acid suppression and monitor appetite, hydration and GI signs."
    },
    {
      "drug_name": "Sucralfate",
      "section": "Exotics overview",
      "content": "GI mucosal protectant used for oesophageal, gastric and duodenal ulceration. It forms a protective barrier and supports mucosal repair."
    },
    {
      "drug_name": "Sucralfate",
      "section": "Key caution",
      "content": "Separate from other oral medicines, especially fluoroquinolones and digoxin. Do not use with perforated ulceration."
    },
    {
      "drug_name": "Lactulose",
      "section": "Exotics overview",
      "content": "Osmotic laxative and ammonia-trapping therapy used for constipation and hepatic encephalopathy support in selected exotic species."
    },
    {
      "drug_name": "Lactulose",
      "section": "Key caution",
      "content": "Reduce dose if diarrhoea develops. Do not administer orally to severely encephalopathic patients at aspiration risk."
    },
    {
      "drug_name": "Tramadol",
      "section": "Exotics overview",
      "content": "Centrally acting analgesic used for mild to moderate pain or as an adjunct. Exotics dose evidence is variable and response should be pain-scored."
    },
    {
      "drug_name": "Tramadol",
      "section": "Key caution",
      "content": "Seizure risk and serotonin syndrome are important concerns, especially with serotonergic drugs or seizure-prone patients."
    }
  ],
